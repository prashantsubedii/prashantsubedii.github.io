{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["astro/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./src/lib/*"],
      "@components/*": ["./src/components/*"]
    },
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["dist", "legacy", "node_modules"]
}
