# ============================================================================
#  Environment variables — COPY to `.env` and fill in. NEVER commit `.env`.
#  Only PUBLIC_* variables are exposed to the browser bundle. That is safe here:
#  the Supabase anon key is designed to be public and is powerless without a
#  valid session + the Row Level Security policies in supabase/schema.sql.
# ============================================================================

# --- Client-safe (embedded in the built site) -------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
PUBLIC_SUPABASE_URL=
# The "anon" / publishable key from Supabase → Project Settings → API.
PUBLIC_SUPABASE_ANON_KEY=
# Canonical site origin (no trailing slash).
PUBLIC_SITE_URL=https://www.prashantsubedi.info.np
# Analytics beacon endpoint (the deployed `track` Edge Function URL). Leave
# empty to disable analytics. e.g. https://<project>.supabase.co/functions/v1/track
PUBLIC_ANALYTICS_URL=

# --- Admin identity (used ONLY in one-time SQL seeding, never in the browser) -
# After you create the single admin user in Supabase Auth, put its details here
# to run supabase/seed_admin.sql. These are NOT read by the frontend build.
ADMIN_EMAIL=
ADMIN_USER_ID=

# --- Server-only secrets (NEVER prefixed PUBLIC_, NEVER sent to the browser) --
# Used only by Supabase Edge Functions / local admin scripts. Set these as
# Supabase Function secrets or GitHub Action secrets — not in the site bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: token for the analytics geo-IP lookup provider (if you use one that
# requires a key). The bundled Edge Function uses a keyless provider by default.
GEOIP_API_KEY=
