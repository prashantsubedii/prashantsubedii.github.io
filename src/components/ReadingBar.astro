---
interface Props { href: string; label: string; }
const { href, label } = Astro.props;
---
<div class="reading-bar">
  <div class="container-page reading-inner">
    <a href={href}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7M5 12h14"/></svg>{label}</a>
    <slot />
  </div>
</div>
<style>
.reading-bar { position: sticky; top: var(--nav-height,80px); z-index: 40; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
.reading-inner { min-height: 58px; padding-block: .5rem; display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
a { display: inline-flex; align-items: center; gap: .5rem; font-size: .85rem; font-weight: 650; white-space: nowrap; color: var(--color-muted); padding: .5rem 0; }
a:hover { color: var(--color-brand-400); }
</style>
