---
import type { Certificate, SectionMeta } from '../../lib/types';
interface Props { section?: SectionMeta; items: Certificate[]; }
const { section, items } = Astro.props;
const isImage = (url: string | null) => !!url && /\.(png|jpe?g|webp|avif|gif)$/i.test(url);
---
<section id="certificates" class="section">
  <div class="container-page">
    <div class="credentials-heading">
      <div class="sec-head"><p class="kicker">{section?.eyebrow ?? 'Continued learning'}</p><h2 class="sec-title">{section?.heading ?? 'Certificates'}</h2></div>
      <div class="slider-controls"><button type="button" data-slide="previous" aria-label="Previous certificates">←</button><button type="button" data-slide="next" aria-label="Next certificates">→</button></div>
    </div>
    <div class="credential-slider" tabindex="0" role="region" aria-label="Certificates">
      {items.map((cert) => {
        const cover = cert.thumbnail_url ?? (isImage(cert.file_url) ? cert.file_url : null);
        const href = cert.credential_url || cert.file_url;
        return (
          <article class="credential-card">
            <div class="credential-cover">
              {cover
                ? <img src={cover} alt={cert.name} loading="lazy" />
                : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="m8 12-1 10 5-3 5 3-1-10M10 8l1.5 1.5L14 7"/></svg>}
            </div>
            <div class="credential-body">
              <h3>{cert.name}</h3>
              {cert.issuer ? <p>{cert.issuer}</p> : null}
              {cert.description ? <p>{cert.description}</p> : null}
              {href ? <a href={href} target="_blank" rel="noopener noreferrer">{cert.credential_url ? 'View credential ↗' : 'Open certificate ↗'}</a> : null}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
.credentials-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; }
.credentials-heading .sec-head { margin-bottom: 0; }
.slider-controls { display: flex; gap: .5rem; }
.slider-controls button { width: 42px; height: 42px; border: 1px solid var(--color-border); border-radius: 13px; background: var(--color-surface); color: var(--color-text); font-size: 1.25rem; }
.credential-slider { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2.5rem)/3); gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: .2rem .1rem 1rem; }
.credential-card { scroll-snap-align: start; border: 1px solid var(--color-border); border-radius: 22px; background: var(--color-surface); overflow: hidden; display: flex; flex-direction: column; min-width: 0; }
.credential-cover { height: 200px; display: grid; place-items: center; background: color-mix(in srgb,var(--color-brand) 8%,var(--color-bg)); color: var(--color-brand-400); }
.credential-cover img { width: 100%; height: 100%; object-fit: contain; padding: .8rem; }
.credential-cover svg { width: 52px; height: 52px; }
.credential-body { padding: 1.3rem; display: flex; flex: 1; flex-direction: column; gap: .6rem; }
.credential-body h3 { font-weight: 750; font-size: 1.1rem; line-height: 1.4; }
.credential-body p { font-size: .88rem; color: var(--color-muted); line-height: 1.65; }
.credential-body a { margin-top: auto; padding-top: .8rem; font-size: .9rem; font-weight: 650; color: var(--color-brand-400); }
@media(max-width:1000px) { .credential-slider { grid-auto-columns: calc((100% - 1.25rem)/2); } }
@media(max-width:600px) { .credential-slider { grid-auto-columns: 88%; } .credentials-heading { align-items: center; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-slide]').forEach(button => button.addEventListener('click', () => {
    const slider = document.querySelector('.credential-slider');
    slider?.scrollBy({ left: (button.dataset.slide === 'next' ? 1 : -1) * slider.clientWidth * .9, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  }));
</script>
