---
import type { SkillCategory } from '../../lib/types';
import { skillIconUrl, skillInitials } from '../../lib/skillIcons';
import LucideIcon from '../LucideIcon.astro';
import type { SectionMeta } from '../../lib/types';
interface Props { section?: SectionMeta; categories: SkillCategory[]; }
const { categories, section } = Astro.props;
const withSkills = categories.filter((c) => c.skills.length > 0);
const clamp = (n: number | null | undefined) => Math.max(0, Math.min(100, n ?? 60));
---
<section class="section" id="skills">
  <div class="container-page">
    <div class="sec-head">
      <p class="kicker">{section?.eyebrow ?? "Skills"}</p>
      <h2 class="sec-title">{section?.heading ?? "Tools & technologies"}</h2>
      <p class="sec-lead">{section?.description ?? "Languages, AI/ML, tools, and the soft skills I bring to a team."}</p>
    </div>

    {withSkills.length ? (
      <div class="skill-cats">
        {withSkills.map((c) => (
          <div class="skill-cat card-glow reveal">
            <div class="cat-head">
              {c.icon ? <span class="cat-ic"><LucideIcon name={c.icon} size={16} /></span> : null}
              <h3 class="cat-name">{c.name}</h3>
            </div>
            <div class="bars">
              {c.skills.map((s) => {
                const url = s.icon_url ?? skillIconUrl(s.name);
                const lvl = clamp(s.level);
                return (
                  <div class="bar-row">
                    <div class="bar-top">
                      <span class="bar-ic">
                        {url ? <img src={url} alt="" width="18" height="18" loading="lazy" />
                          : s.icon ? <LucideIcon name={s.icon} size={15} />
                          : <span class="mini mono">{skillInitials(s.name)}</span>}
                      </span>
                      <span class="bar-name">{s.name}</span>
                      {s.level != null ? <span class="bar-pct mono">{lvl}%</span> : null}
                    </div>
                    {s.level != null ? <div class="bar-track"><span class="bar-fill" style={`--w:${lvl}%`}></span></div> : null}
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="empty mono">// skills will appear here once added</p>
    )}
  </div>
</section>

<style>

.skill-cats { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 4rem; }
.skill-cat { background: transparent; border: 0; border-top: 1px solid var(--color-border); border-radius: 0; padding-top: 1.25rem; }
.cat-head { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.75rem; }
.cat-ic { color: var(--color-brand-400); }
.cat-name { font-size: .95rem; font-weight: 600; }
.bars { display: grid; gap: 1.1rem; }
.bar-row { display: grid; gap: .6rem; }
.bar-top { display: flex; align-items: center; gap: .7rem; }
.bar-ic { width: 1.6rem; height: 1.6rem; display: grid; place-items: center; background: #eaece8; border-radius: 3px; color: #285cc0; flex-shrink: 0; }
.bar-ic img { width: 17px; height: 17px; object-fit: contain; }
.mini { font-size: .6rem; }
.bar-name { flex: 1; font-size: .82rem; }
.bar-pct { color: var(--color-faint); font-size: .65rem; }
.bar-track { height: 4px; background: var(--color-border); margin-left: 2.3rem; border-radius: 2px; }
.bar-fill { display: block; height: 100%; width: var(--w); background: var(--color-brand-400); transform-origin: left; transition: transform 800ms ease; border-radius: 2px; }
:global(html.js-motion) .skill-cat:not(.in) .bar-fill { transform: scaleX(0); }
@media(max-width: 640px) { .skill-cats { grid-template-columns: 1fr; gap: 2rem; } }
@media(prefers-reduced-motion: reduce) { :global(html.js-motion) .skill-cat:not(.in) .bar-fill { transform: none; } }

.skill-cats { gap: 1.25rem; }
.skill-cat { padding: 1.75rem; border: 1px solid var(--color-border); border-radius: 20px; background: var(--color-surface); box-shadow: none; }
.cat-head { padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-border); }
.cat-ic { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: color-mix(in srgb,var(--color-brand) 15%,transparent); }
.bar-ic { width: 2rem; height: 2rem; border-radius: 8px; }
.bar-track { margin-left: 2.7rem; background: var(--color-surface-2); height: 5px; }
.bar-fill { background: linear-gradient(90deg,#5484ec,#9f9af4); }
</style>
