---
import type { SectionMeta, SiteSettings, SocialLink } from '../lib/types';
import SocialIcon from './SocialIcon.astro';

import FooterArt from './FooterArt.astro';
import BrandMark from './BrandMark.astro';
interface Props { settings: SiteSettings; sections: SectionMeta[]; socials: SocialLink[]; anchorBase?: string; }
const { settings, sections, socials, anchorBase = '' } = Astro.props;
const navItems = sections.filter((s) => s.is_visible && s.in_nav && !['certificates', 'blog', 'frames'].includes(s.key)).sort((a, b) => a.sort_order - b.sort_order);
const year = new Date().getFullYear();
const copyright = settings.footer_copyright ?? `© ${year} ${settings.site_name}`;
const role = 'Aspiring AI/ML Engineer';
---
<footer class="site-footer">
  <div class="container-page footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <BrandMark />
        <span>{settings.site_name}</span>
      </div>
      {settings.footer_tagline ? <p class="footer-tagline">{settings.footer_tagline}</p> : null}
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {navItems.slice(0, 6).map((s) => <a href={`${anchorBase}#${s.key}`}>{s.label}</a>)}
      <a href="/blog">Writing</a>
      <a href="/frames" data-managed-nav="frames" hidden={!!import.meta.env.PUBLIC_SUPABASE_URL}>Frames</a>
      <a href={`${anchorBase}#certificates`} data-managed-nav="certificates" hidden>Certificates</a>
    </nav>

    <div class="footer-social">
      {socials.map((s) => (
        <a href={s.url} class="social-btn" aria-label={s.label ?? s.platform}
           rel={s.url.startsWith('http') ? 'me noopener' : undefined}
           target={s.url.startsWith('http') ? '_blank' : undefined}>
          <SocialIcon platform={s.platform} />
        </a>
      ))}
    </div>
  </div>

  <div class="container-page footer-legal">
    <span class="mono">{copyright} / {role} / {settings.contact_location ?? 'Nepal'}</span>
    <a class="back-top" href="#top">Back to top <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 12 6-6 6 6M12 6v14M5 3h14"/></svg></span></a>
  </div>
  <FooterArt />
</footer>

<style>
.site-footer { border-top: 1px solid var(--color-border); background: var(--color-bg); }
.footer-grid { display: grid; grid-template-columns: 1.1fr 1fr auto; gap: 2rem; padding-block: 3rem 1rem; }
.brand { display: flex; align-items: center; gap: .75rem; font-size: .95rem; font-weight: 600; }
.brand-mark { font-size: 1.1rem; color: var(--color-brand-400); letter-spacing: -.08em; }
.footer-tagline { margin-top: .75rem; font-size: .8rem; line-height: 1.8; max-width: 34ch; color: var(--color-muted); }
.footer-nav { display: flex; flex-wrap: wrap; align-content: start; gap: .2rem 1rem; }
.footer-nav a { min-height: 2rem; font-size: .75rem; color: var(--color-muted); }
.footer-nav a:hover { color: var(--color-brand-400); text-decoration: underline; text-underline-offset: 5px; }
.footer-social { display: flex; gap: .5rem; }
.social-btn { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--color-border); border-radius: 50%; color: var(--color-muted); }
.social-btn:hover { color: var(--color-brand-400); border-color: var(--color-brand-400); }
.footer-legal { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1rem .45rem; color: var(--color-faint); font-size: .62rem; line-height: 1.8; }
.back-top { display: inline-flex; align-items: center; gap: .65rem; white-space: nowrap; color: var(--color-muted); font-size: .78rem; font-weight: 650; align-self: flex-start; }
.back-top span { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); transition: transform 180ms ease, border-color 180ms ease; }
.back-top:hover span { transform: translateY(-3px); border-color: var(--color-brand-400); }
[hidden] { display: none !important; }
.back-top:hover { color: var(--color-brand-400); }
@media(max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-social { grid-column: 1/-1; } }
@media(max-width: 550px) { .footer-grid { grid-template-columns: 1fr; gap: 1.5rem; } .footer-legal { flex-direction: column; gap: .75rem; } }
.site-footer { position: relative; border-top: 0; margin-top: 2rem; background: linear-gradient(160deg,color-mix(in srgb,var(--color-surface) 94%,var(--color-brand) 6%),var(--color-bg) 70%); border-radius: 64px 64px 0 0; overflow: hidden; box-shadow: inset 0 1px 0 color-mix(in srgb,var(--color-brand-400) 20%,transparent); }
.footer-grid, .footer-legal { position: relative; }
.footer-grid { padding-top: 2rem; }
.footer-legal { border-top: 1px solid color-mix(in srgb,var(--color-border) 65%,transparent); }
@media(max-width:700px) { .site-footer { border-radius: 30px 30px 0 0; } }
</style>
