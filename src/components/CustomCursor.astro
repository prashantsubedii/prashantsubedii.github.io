<div class="custom-cursor" aria-hidden="true">
  <span class="cursor-frame"></span>
  <span class="cursor-core"></span>
</div>

<script>
  const cursor = document.querySelector<HTMLElement>('.custom-cursor');
  const precisePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  if (cursor && precisePointer.matches && !reducedMotion.matches) {
    document.documentElement.classList.add('has-custom-cursor');
    let x = -40;
    let y = -40;
    let frame = 0;

    const render = () => {
      cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      frame = 0;
    };

    window.addEventListener('pointermove', (event) => {
      x = event.clientX;
      y = event.clientY;
      cursor.classList.add('is-visible');
      if (!frame) frame = requestAnimationFrame(render);
    }, { passive: true });

    document.addEventListener('pointerover', (event) => {
      const target = event.target as Element;
      cursor.classList.toggle('is-active', Boolean(target.closest('a, button, [role="button"]')));
      cursor.classList.toggle('is-text', Boolean(target.closest('input, textarea, [contenteditable="true"]')));
    });
    document.addEventListener('pointerleave', () => cursor.classList.remove('is-visible'));
    window.addEventListener('blur', () => cursor.classList.remove('is-visible'));
  }
</script>

<style>
.custom-cursor { display: none; }
@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
  :global(html.has-custom-cursor),
  :global(html.has-custom-cursor a),
  :global(html.has-custom-cursor button),
  :global(html.has-custom-cursor [role="button"]) { cursor: none; }
  :global(html.has-custom-cursor input),
  :global(html.has-custom-cursor textarea),
  :global(html.has-custom-cursor [contenteditable="true"]) { cursor: text; }
  .custom-cursor {
    display: block;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 500;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 130ms ease;
    will-change: transform;
  }
  .custom-cursor.is-visible { opacity: 1; }
  .cursor-frame {
    position: absolute;
    inset: 5px;
    border: 1px solid color-mix(in srgb, var(--color-brand-400) 78%, white);
    border-radius: 5px;
    transform: rotate(0deg);
    transition: inset 180ms ease, transform 220ms ease, border-radius 180ms ease, background 180ms ease;
  }
  .cursor-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--color-brand-400);
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .custom-cursor.is-active .cursor-frame {
    inset: -4px;
    transform: rotate(135deg);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-brand) 12%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--color-brand) 35%, transparent);
  }
  .custom-cursor.is-text { opacity: 0; }
}
</style>
