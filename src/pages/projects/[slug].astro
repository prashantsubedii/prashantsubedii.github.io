---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ReadingBar from '../../components/ReadingBar.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import { getSiteSettings, getSocialLinks, getSections } from '../../lib/content';
import { getPinnedRepos, getRepoReadmeHtml, type Repo } from '../../lib/github';

export async function getStaticPaths() {
  const repos = getPinnedRepos();
  const withReadme = await Promise.all(repos.map(async (repo) => ({
    params: { slug: repo.slug },
    props: { repo, readme: await getRepoReadmeHtml(repo) },
  })));
  return withReadme;
}

interface Props { repo: Repo; readme: string }
const { repo, readme } = Astro.props;

const [settings, socials, sections] = await Promise.all([
  getSiteSettings(), getSocialLinks(), getSections(),
]);
---
<BaseLayout
  title={`${repo.name} | ${settings.site_name}`}
  description={repo.description || `${repo.name} by ${settings.site_name}`}
  path={`/projects/${repo.slug}`}
  type="article"
  settings={settings}
  socials={socials}
>
  <SiteNav sections={sections} settings={settings} anchorBase="/" />
  <ReadingBar href="/#featured-projects" label="All projects" />
  <main id="main-content" tabindex="-1" class="section">
    <article class="container-narrow">

      <header class="proj-header">
        <div class="ph-top">
          <span class="ph-ic"><LucideIcon name="git-fork" size={20} /></span>
          <div>
            <h1 class="proj-h1">{repo.name}</h1>
            {repo.language ? <span class="ph-lang mono"><LucideIcon name="code" size={14} />{repo.language}</span> : null}
          </div>
        </div>
        {repo.description ? <p class="proj-lede">{repo.description}</p> : null}
        {repo.topics?.length ? <div class="proj-tags">{repo.topics.map((t) => <span class="tag-brand">{t}</span>)}</div> : null}
        <div class="ph-actions">
          <a class="btn btn-primary" href={repo.url} target="_blank" rel="noopener"><LucideIcon name="github" size={16} />View on GitHub</a>
          <a class="btn btn-ghost" href="/#featured-projects"><LucideIcon name="layers" size={16} />More projects</a>
        </div>
      </header>

      {readme
        ? <div class="prose readme" set:html={readme} />
        : (
          <div class="no-readme card">
            <p>This project's README couldn't be loaded here. You can read it on GitHub.</p>
            <a class="btn btn-primary" href={repo.url} target="_blank" rel="noopener"><LucideIcon name="github" size={16} />Open on GitHub</a>
          </div>
        )}
    </article>
  </main>
  <SiteFooter settings={settings} sections={sections} socials={socials} anchorBase="/" />
</BaseLayout>

<style>
  .container-narrow { width: 100%; max-width: 46rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 1.5rem); }
  .back-link { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.82rem; }
  .back-link:hover { color: var(--color-brand-400); }
  .proj-header { margin-top: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .ph-top { display: flex; align-items: center; gap: 0.85rem; }
  .ph-ic { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 0.8rem; color: var(--color-brand-400); background: color-mix(in srgb, var(--color-brand) 12%, transparent); border: 1px solid color-mix(in srgb, var(--color-brand) 22%, var(--color-border)); flex: 0 0 auto; }
  .proj-h1 { font-size: clamp(1.7rem, 4.5vw, 2.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .ph-lang { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-muted); font-size: 0.8rem; margin-top: 0.3rem; }
  .ph-lang .dot { width: 0.65rem; height: 0.65rem; border-radius: 50%; }
  .proj-lede { margin-top: 1rem; color: var(--color-muted); font-size: 1.05rem; line-height: 1.65; }
  .proj-tags { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ph-actions { margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .no-readme { margin-top: 2rem; padding: 1.75rem; display: grid; gap: 1rem; justify-items: start; color: var(--color-muted); }

  .prose { margin-top: 2rem; color: var(--color-text); font-size: 1.02rem; line-height: 1.8; }
  .prose :global(h1) { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; margin: 2rem 0 0.75rem; }
  .prose :global(h2) { font-size: 1.35rem; font-weight: 700; margin: 1.75rem 0 0.7rem; padding-bottom: 0.35rem; border-bottom: 1px solid var(--color-border); }
  .prose :global(h3) { font-size: 1.15rem; font-weight: 700; margin: 1.4rem 0 0.5rem; }
  .prose :global(p) { margin: 0 0 1.1rem; }
  .prose :global(a) { color: var(--color-brand-400); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1rem 1.25rem; display: grid; gap: 0.4rem; }
  .prose :global(li) { line-height: 1.7; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 0.5rem; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.88em; background: var(--color-surface); padding: 0.1rem 0.35rem; border-radius: 0.35rem; border: 1px solid var(--color-border); }
  .prose :global(pre) { margin: 1.25rem 0; padding: 1rem 1.15rem; overflow-x: auto; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.6rem; }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.25rem 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--color-border); padding: 0.5rem 0.75rem; text-align: left; font-size: 0.92rem; }
  .prose :global(blockquote) { margin: 1.25rem 0; padding: 0.5rem 1rem; border-left: 3px solid var(--color-brand); color: var(--color-muted); background: var(--color-surface); border-radius: 0 0.5rem 0.5rem 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--color-border); margin: 2rem 0; }
</style>
