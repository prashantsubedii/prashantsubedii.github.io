---
// The admin dashboard. This route name is NOT a security control — real
// security is Supabase Auth + the RLS policies in supabase/policies.sql.
// The whole app is a client-only island, so no admin code or data is included
// in the public site bundle or prerendered HTML.
import '../../styles/global.css';
import '../../admin/admin.css';
import AdminApp from '../../admin/AdminApp.tsx';
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · Prashant Subedi</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <AdminApp client:only="react" />
  </body>
</html>
