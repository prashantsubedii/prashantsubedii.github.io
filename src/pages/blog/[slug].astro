---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import NepaliTranslation from '../../components/NepaliTranslation.astro';
import ReadingBar from '../../components/ReadingBar.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import { getSiteSettings, getSocialLinks, getSections } from '../../lib/content';
import { getMediumPosts, mediumHandleFrom, type MediumPost } from '../../lib/medium';
import { monthYear } from '../../lib/format';

export async function getStaticPaths() {
  const socials = await getSocialLinks();
  const handle = mediumHandleFrom(socials.find((s) => s.platform === 'medium')?.url) ?? 'prashantsubedii';
  const posts = await getMediumPosts(handle, 24);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: MediumPost }
const { post } = Astro.props;

const [settings, socials, sections] = await Promise.all([
  getSiteSettings(), getSocialLinks(), getSections(),
]);

const description = post.excerpt ?? settings.seo_description;
const image = post.thumbnail ?? settings.social_image_url;
const origin = settings.canonical_domain.replace(/\/$/, '');

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  ...(image ? { image } : {}),
  ...(post.date ? { datePublished: post.date } : {}),
  author: { '@type': 'Person', name: settings.site_name, url: origin + '/' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${origin}/blog/${post.slug}` },
  ...(post.tags?.length ? { keywords: post.tags.join(', ') } : {}),
};
---
<BaseLayout
  title={`${post.title} | ${settings.site_name}`}
  description={description}
  path={`/blog/${post.slug}`}
  image={image}
  type="article"
  settings={settings}
  socials={socials}
  jsonLd={[blogPostingLd]}
>
  <SiteNav sections={sections} settings={settings} anchorBase="/" />
  <ReadingBar href="/blog" label="All articles"><NepaliTranslation /></ReadingBar>
  <main id="main-content" tabindex="-1" class="section">
    <article class="container-narrow" data-translate-content>

      <header class="post-header">
        <div class="post-meta mono">
          {post.date ? <span>{monthYear(post.date)}</span> : null}
          <span>{post.readingMinutes} min read</span>
          <span>Medium</span>
        </div>
        <h1 class="post-h1">{post.title}</h1>
        {post.tags?.length ? <div class="post-tags">{post.tags.map((t) => <span class="tag-brand">#{t}</span>)}</div> : null}
      </header>

      <div class="prose" set:html={post.content} />

      <div class="post-foot" data-no-translate>
        <a class="btn btn-primary" href={post.url} target="_blank" rel="noopener">Read on Medium<LucideIcon name="arrow-up-right" size={16} /></a>
        <a class="btn btn-ghost" href="/blog"><LucideIcon name="book-open" size={16} />More articles</a>
      </div>
    </article>
  </main>
  <SiteFooter settings={settings} sections={sections} socials={socials} anchorBase="/" />
</BaseLayout>

<style>
  .container-narrow { width: 100%; max-width: 44rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 1.5rem); }
  .back-link { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.82rem; }
  .back-link:hover { color: var(--color-brand-400); }
  .back-link :global(.flip) { transform: rotate(180deg); }
  .post-header { margin-top: 1.5rem; }
  .post-meta { color: var(--color-faint); font-size: 0.8rem; display: flex; gap: 0.4rem; align-items: center; }
  .post-meta .sep { opacity: 0.6; }
  .post-h1 { font-size: clamp(2rem, 5.5vw, 2.9rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.08; margin-top: 0.65rem; }
  .post-tags { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .prose { margin-top: 2.25rem; color: var(--color-text); font-size: 1.07rem; line-height: 1.85; }
  .prose :global(h1) { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.02em; margin: 2.25rem 0 0.75rem; }
  .prose :global(h2) { font-size: 1.45rem; font-weight: 700; letter-spacing: -0.02em; margin: 2rem 0 0.75rem; }
  .prose :global(h3) { font-size: 1.2rem; font-weight: 700; margin: 1.5rem 0 0.6rem; }
  .prose :global(p) { margin: 0 0 1.2rem; }
  .prose :global(a) { color: var(--color-brand-400); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2rem 1.25rem; display: grid; gap: 0.45rem; }
  .prose :global(li) { line-height: 1.75; }
  .prose :global(blockquote) { margin: 1.5rem 0; padding: 0.65rem 1.15rem; border-left: 3px solid var(--color-brand); color: var(--color-muted); background: var(--color-surface); border-radius: 0 0.5rem 0.5rem 0; font-style: italic; }
  .prose :global(figure) { margin: 1.75rem 0; }
  .prose :global(figcaption) { margin-top: 0.5rem; text-align: center; color: var(--color-faint); font-size: 0.85rem; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; background: var(--color-surface); padding: 0.1rem 0.35rem; border-radius: 0.35rem; border: 1px solid var(--color-border); }
  .prose :global(pre) { margin: 1.5rem 0; padding: 1rem 1.15rem; overflow-x: auto; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.6rem; }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(img) { border-radius: 0.6rem; border: 1px solid var(--color-border); width: 100%; height: auto; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--color-border); margin: 2rem 0; }

  .post-foot { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 0.7rem; }
</style>
